+.communication-attachment-card.is-image .communication-attachment-main { display: grid; gap: 8px; padding: 6px 6px 10px; }
+.communication-attachment-image { width: 100%; height: 180px; object-fit: cover; border-radius: 9px; background: #e9efeb; }
