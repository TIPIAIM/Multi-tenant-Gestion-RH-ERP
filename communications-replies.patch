+.communication-emoji-picker button { border: 1px solid #d5e3db; border-radius: 8px; background: white; font-size: 1.2rem; min-width: 38px; min-height: 38px; cursor: pointer; }
+.communication-forward-panel { display: grid; gap: 9px; padding: 16px; margin: 8px 12px; border: 1px solid #cddcd4; border-radius: 12px; background: #f4faf6; max-height: 45dvh; overflow: auto; }
+.communication-forward-panel header { display: flex; justify-content: space-between; align-items: center; }
