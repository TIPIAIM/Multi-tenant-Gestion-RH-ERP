+.communication-message-actions { position: relative; }
+.communication-message-menu { position: absolute; bottom: 30px; right: 0; z-index: 5; display: grid; min-width: 140px; padding: 5px; background: white; border: 1px solid #cddcd4; border-radius: 10px; box-shadow: 0 6px 18px #0b25361c; }
